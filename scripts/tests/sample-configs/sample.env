# NVIDIA Air API Configuration
# Copy this file to scripts/tests/.env and fill in your credentials

# NVIDIA Air API Token (from Account Settings -> API Tokens)
# IMPORTANT: Internal and external sites use DIFFERENT tokens!
AIR_API_TOKEN=your_api_token_here

# Your username (email address)
AIR_USERNAME=your_email@example.com

# NVIDIA Air API URL (script auto-adds /api/v1)
# External (default): https://air.nvidia.com
# Internal (NVIDIA VPN): https://air-inside.nvidia.com
AIR_API_URL=https://air.nvidia.com

# Simulation ID (UUID from your simulation URL)
SIMULATION_ID=your_simulation_id_here
