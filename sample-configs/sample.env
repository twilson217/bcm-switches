# NVIDIA Air API Configuration
# Copy this file to .configs/.env and fill in your credentials

# NVIDIA Air API Token
# Get your token from: https://air.nvidia.com (Account Settings -> API Tokens)
# For NVIDIA employees: use https://air-inside.nvidia.com instead
AIR_API_TOKEN=your_api_token_here

# NVIDIA Air API URL
# External (default): https://air.nvidia.com/api/v1
# Internal (NVIDIA employees with VPN): https://air-inside.nvidia.com/api/v1
AIR_API_URL=https://air.nvidia.com/api/v1

# Simulation ID (UUID)
# Get this from your NVIDIA Air simulation URL
# Example: if URL is https://air.nvidia.com/simulation/abc12345-...
# Then SIMULATION_ID=abc12345-...
SIMULATION_ID=your_simulation_id_here
